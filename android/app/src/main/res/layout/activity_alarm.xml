<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_alarm_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingLeft="28dp"
        android:paddingRight="28dp"
        android:paddingTop="32dp"
        android:paddingBottom="28dp">

        <!-- ===== Live clock (system alarm style) ===== -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom">

            <TextView
                android:id="@+id/current_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="80sp"
                android:textStyle="bold"
                android:textColor="@color/alarm_text"
                android:fontFamily="sans-serif-light"
                android:includeFontPadding="false"
                android:text="8:00" />

            <TextView
                android:id="@+id/am_pm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/alarm_accent"
                android:fontFamily="sans-serif-medium"
                android:layout_marginLeft="8dp"
                android:layout_marginBottom="10dp"
                android:text="AM" />
        </LinearLayout>

        <!-- Current date -->
        <TextView
            android:id="@+id/current_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textColor="@color/alarm_text_secondary"
            android:layout_marginTop="2dp"
            android:text="Friday, August 21" />

        <!-- Alarm label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TIME TO TAKE YOUR MEDICINE"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/alarm_accent"
            android:letterSpacing="0.18"
            android:layout_marginTop="36dp" />

        <!-- Medicine icon -->
        <ImageView
            android:id="@+id/medicine_icon"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="Medicine icon"
            android:layout_marginTop="20dp" />

        <!-- Medicine name -->
        <TextView
            android:id="@+id/medicine_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="@color/alarm_text"
            android:gravity="center"
            android:layout_marginTop="14dp"
            android:text="Medication" />

        <!-- Dosage -->
        <TextView
            android:id="@+id/dosage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textColor="@color/alarm_text_secondary"
            android:gravity="center"
            android:layout_marginTop="6dp"
            android:text="500 mg" />

        <!-- Instructions chip -->
        <TextView
            android:id="@+id/instructions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/alarm_instruction_text"
            android:background="@drawable/bg_instruction_chip"
            android:paddingLeft="18dp"
            android:paddingRight="18dp"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:text="Instructions" />

        <!-- Scheduled time -->
        <TextView
            android:id="@+id/scheduled_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/alarm_text"
            android:alpha="0.85"
            android:layout_marginTop="16dp"
            android:text="Scheduled for 8:00 AM" />

        <!-- ===== Actions ===== -->

        <!-- Take Medicine -->
        <Button
            android:id="@+id/take_button"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="36dp"
            android:background="@drawable/bg_button_take"
            android:text="TAKE MEDICINE"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="@color/alarm_button_text"
            android:stateListAnimator="@null" />

        <!-- Snooze row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="14dp">

            <Button
                android:id="@+id/snooze5_button"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginRight="7dp"
                android:background="@drawable/bg_button_snooze"
                android:text="SNOOZE 5 MIN"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/alarm_text"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/snooze10_button"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginLeft="7dp"
                android:background="@drawable/bg_button_snooze"
                android:text="SNOOZE 10 MIN"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/alarm_text"
                android:stateListAnimator="@null" />
        </LinearLayout>

        <!-- Dismiss -->
        <Button
            android:id="@+id/dismiss_button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_button_dismiss"
            android:text="DISMISS"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/alarm_text_secondary"
            android:stateListAnimator="@null" />

    </LinearLayout>
</ScrollView>